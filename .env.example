# Server configuration
PORT=3090
NODE_ENV=development

# JWT Authentication (Required in production)
JWT_SECRET=change-this-to-a-secure-random-secret-in-production

# External API Protection (Optional: set to protect /api/external/* routes)
EXTERNAL_API_KEY=

# Initial Admin User (Required on first startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-secure-password
